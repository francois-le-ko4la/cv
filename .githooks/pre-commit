#!/bin/sh
# Lint staged Markdown files with the same rules as CI (.markdownlint.json).
# Enable once per clone: git config core.hooksPath .githooks
VERSION=0.24.0
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
[ -z "$files" ] && exit 0

if command -v npx >/dev/null 2>&1; then
  npx --yes "markdownlint-cli2@$VERSION" $files
elif command -v docker >/dev/null 2>&1; then
  docker run --rm -v "$PWD:/workdir" "davidanson/markdownlint-cli2:v$VERSION" $files
else
  echo "pre-commit: neither npx nor docker found, Markdown lint skipped" >&2
  exit 0
fi || {
  echo "pre-commit: fix the Markdown errors above, or commit with --no-verify" >&2
  exit 1
}
